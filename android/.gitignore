# Kotlin build session files (regenerated by Gradle)
.kotlin/

# Release signing kept in the repo ON PURPOSE: the key must be identical on every dev
# machine, otherwise an APK built on one machine cannot install over an app built on
# another (INSTALL_FAILED_UPDATE_INCOMPATIBLE). Personal app, private repo.
!key.properties
!keystore/
!keystore/*.jks
